{
  "title": "Distributed Task Queue Overview",
  "uid": "dtq-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tasks processed/sec, by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(tasks_processed_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Task duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, task_type) (rate(task_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{task_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, task_type) (rate(task_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{task_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "RabbitMQ queue depth, by priority",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "rabbitmq_queue_depth",
          "legendFormat": "{{priority}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Worker active tasks (in-flight)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "worker_active_tasks",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Outbox unpublished rows",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "outbox_unpublished_rows", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Dead-lettered tasks (current)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "dead_lettered_tasks_current", "refId": "A" }]
    },
    {
      "id": 7,
      "title": "Outbox relay throughput/sec",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(outbox_relayed_total[1m])",
          "legendFormat": "relayed/sec",
          "refId": "A"
        },
        {
          "expr": "rate(scheduler_dispatched_total[1m])",
          "legendFormat": "scheduler dispatched/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "API request rate, by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Tasks created/sec, by priority",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (priority) (rate(tasks_created_total[1m]))",
          "legendFormat": "{{priority}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(tasks_rejected_total[1m]))",
          "legendFormat": "rejected: {{reason}}",
          "refId": "B"
        }
      ]
    }
  ]
}
