# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_USER=dtq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dtq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dtq:change-me@postgres:5432/dtq

# ---- RabbitMQ ----
RABBITMQ_USER=dtq
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://dtq:change-me@rabbitmq:5672/

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Phase 23: required as the X-API-Key header on every /tasks and
# /workers request (services/api/auth.py) -- see docs/security.md.
# A real deployment must change this; the API logs a startup warning
# if it's still this placeholder outside ENVIRONMENT=development.
API_KEY=change-me
# Phase 23: requests to POST /tasks with a larger body are rejected
# with 413 before being read into memory. See docs/security.md.
MAX_REQUEST_BODY_BYTES=1048576

# ---- Worker ----
WORKER_CONCURRENCY=10
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=15
WORKER_SHUTDOWN_GRACE_PERIOD_SECONDS=30

# ---- Priority scheduling ----
PRIORITY_WEIGHT_HIGH=4
PRIORITY_WEIGHT_NORMAL=2
PRIORITY_WEIGHT_LOW=1
PRIORITY_POLL_IDLE_SLEEP_SECONDS=0.05

# ---- Rate limiting and backpressure ----
RATE_LIMIT_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_SECONDS=1
BACKPRESSURE_MAX_QUEUE_DEPTH=10000

# ---- Scheduler ----
SCHEDULER_POLL_INTERVAL_SECONDS=1.0
SCHEDULER_BATCH_SIZE=50

# ---- Outbox relay ----
OUTBOX_RELAY_POLL_INTERVAL_SECONDS=0.5
OUTBOX_RELAY_BATCH_SIZE=100

# ---- Retries ----
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=60.0
RETRY_JITTER_FRACTION=0.2

# ---- Metrics ----
WORKER_METRICS_PORT=9101
SCHEDULER_METRICS_PORT=9102
OUTBOX_RELAY_METRICS_PORT=9103
METRICS_POLL_INTERVAL_SECONDS=5.0

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Tracing ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_TRACES_ENABLED=true

# ---- Circuit breaker ----
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_DURATION_SECONDS=30.0
