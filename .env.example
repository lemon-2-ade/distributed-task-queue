# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_USER=dtq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dtq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dtq:change-me@postgres:5432/dtq

# ---- RabbitMQ ----
RABBITMQ_USER=dtq
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://dtq:change-me@rabbitmq:5672/

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me

# ---- Worker ----
WORKER_CONCURRENCY=10
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=15
WORKER_SHUTDOWN_GRACE_PERIOD_SECONDS=30

# ---- Retries ----
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=60.0
RETRY_JITTER_FRACTION=0.2
